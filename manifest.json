{
  "manifest_version": 3,
  "name": "臺灣民事實務工具",
  "version": "2.1",
  "description": "臺灣民事實務輔助：金額速算、裁判費試算、救濟期間、日期計算、利息與折舊試算。",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://cdn.jsdelivr.net/*"
  ],
  "side_panel": {
    "default_path": "popup.html?sidepanel=1"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "開啟臺灣民事實務工具"
  }
}